# --- LLM providers (at least one required) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=phi-4

# --- Email send (Resend) ---
RESEND_API_KEY=

# Sandbox-only sender used until you verify a domain. Email is delivered only
# to RESEND_TEST_EMAIL while RESEND_PROD=false.
RESEND_FROM_EMAIL=onboarding@resend.dev
RESEND_TEST_EMAIL=

# Set to true ONLY after your sending domain is verified at resend.com.
# When false, sends to anyone other than RESEND_TEST_EMAIL are blocked.
RESEND_PROD=false

# Required when RESEND_PROD=true. Must match the domain in RESEND_FROM_EMAIL.
RESEND_DOMAIN=

# --- Logging ---
LOG_LEVEL=info
